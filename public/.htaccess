<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Block access to sensitive files like .env
  <FilesMatch "^\.env">
    Order allow,deny
    Deny from all
  </FilesMatch>

  # 2. Direct API routes to PHP endpoints on Hostinger
  RewriteRule ^api/create-order/?$ api/create-order.php [L,QSA]
  RewriteRule ^api/verify-payment/?$ api/verify-payment.php [L,QSA]
  RewriteRule ^api/contact/?$ api/contact.php [L,QSA]

  # 3. Do not rewrite if file, directory, or symlink exists
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # 4. Fallback all React Router SPA paths to index.html
  RewriteRule . /index.html [L]
</IfModule>

# Caching & Performance for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
