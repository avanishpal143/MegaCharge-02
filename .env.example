# ========================================================
# MEGACHARGE CONFIGURATION (.env)
# ========================================================

# 1. Razorpay Credentials
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 2. Admin Alert Email (Where to receive booking notifications)
ADMIN_ALERT_EMAIL=info@megacharge.co.in

# 3. Email Delivery Method (Choose OPTION A or OPTION B):

# OPTION A: Resend API (Recommended - Easiest & Modern)
# Get a free key at https://resend.com (3,000 free emails/mo)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=MegaCharge Orders <onboarding@resend.dev>

# OPTION B: Gmail / Webmail SMTP (Alternative)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
